            "activity": "Validate Bronze Row Count",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@and(\n    equals(variables('run_mode'), 'NEW'),\n    equals(activity('ingestion').output.result.exitValue, 'NO_DATA')\n)",
