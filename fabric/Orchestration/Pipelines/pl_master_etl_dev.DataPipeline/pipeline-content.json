      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "@if(\n    equals(\n        toUpper(variables('run_mode')),\n        'NEW'\n    ),\n    'SELECT id,\n            source_system,\n            source_type,\n            source_name,\n            source_location,\n            source_format,\n            delimiter,\n            load_type,\n            primary_key,\n            source_to_bronze_mapping_path,\n            bronze_to_silver_mapping_path,\n            silver_transform_name,\n            watermark_column,\n            bronze_table_name,\n            silver_table_name,\n            load_sequence,\n            is_active,\n            created_at,\n            updated_at\n     FROM cfg.source_table\n     ORDER BY load_sequence',\n    concat(\n        'SELECT s.id,\n                s.source_system,\n                s.source_type,\n                s.source_name,\n                s.source_location,\n                s.source_format,\n                s.delimiter,\n                s.load_type,\n                s.primary_key,\n                s.source_to_bronze_mapping_path,\n                s.bronze_to_silver_mapping_path,\n                s.silver_transform_name,\n                s.watermark_column,\n                s.bronze_table_name,\n                s.silver_table_name,\n                s.load_sequence,\n                s.is_active,\n                s.created_at,\n                s.updated_at\n         FROM cfg.source_table s\n         JOIN log.audit_table_session l\n             ON s.id = l.source_table_id\n         WHERE l.session_id = ''',\n        variables('previous_session_id'),\n        '''\n         AND (\n             UPPER(l.silver_status) = ''FAILED''\n             OR UPPER(l.silver_status) = ''NOT_RUN''\n         )\n         ORDER BY s.load_sequence'\n    )\n)",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "AzureSqlTable",
            "typeProperties": {
              "database": "lh_insurance_dev"
            },
            "schema": [],
            "externalReferences": {
              "connection": "41c94ad4-2c37-4565-8d25-03a700377ef2"
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "lk_tables_need_load_for_silver",
        "dependsOn": [
