model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measure

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Measures ","dim_agent","dim_cancellation_reason","dim_coverage","dim_customer","dim_date","dim_package","dim_payment_method","dim_payment_status","dim_policy","dim_policy_status","dim_provider","dim_quotation","dim_quotation_status","dim_vehicle","fact_cancellation","fact_payment","fact_policy","fact_quotation","fact_quotation_item"]

annotation PBI_ProTooling = ["WebModelingEdit","CalcGroup","DevMode"]

ref table 'Measures '
ref table 'Measures DB2'
ref table dim_agent
ref table dim_cancellation_reason
ref table dim_coverage
ref table dim_customer
ref table dim_date
ref table dim_package
ref table dim_payment_method
ref table dim_payment_status
ref table dim_policy
ref table dim_policy_status
ref table dim_provider
ref table dim_quotation
ref table dim_quotation_status
ref table dim_vehicle
ref table fact_cancellation
ref table fact_payment
ref table fact_policy
ref table fact_quotation
ref table fact_quotation_item

ref role ROLE_CUSTOMER
ref role ROLE_AGENT

ref cultureInfo en-US

