table 'Measures DB2'
	lineageTag: b94ef46e-b5ff-4104-9d78-e866acf98a07

	measure 'Active Policies' = CALCULATE(COUNTROWS(fact_policy), dim_policy_status[policy_status_code]="ACTIVE", USERELATIONSHIP(fact_policy[policy_end_date_key], dim_date[date_key]), dim_date[full_date] >= TODAY())
		lineageTag: dbb19e59-0ca3-4555-bbac-8b02d08338a0

	measure 'Cancelled Policies' = CALCULATE(COUNTROWS(fact_cancellation))
		formatString: 0
		lineageTag: 5c3fb1de-9700-4cbe-baad-e89c6c81e522

	measure 'Payment Collection Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_payment), dim_payment_status[payment_status_code] = "PAID"), COUNTROWS(fact_payment), 0)
		lineageTag: 955b88a5-af90-4dca-ab81-319ca3511f0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Written Premium' = CALCULATE(SUM(fact_policy[premium_amount]), dim_policy_status[policy_status_code] IN {"ACTIVE","EXPIRED"})
		lineageTag: e01b5eeb-9a53-4b97-83e5-8200907ca861

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Collected Premium' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PAID")
		lineageTag: b3f97019-72b4-42dc-87c8-d1f6d3cfe6d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Payments (VND)' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING")
		lineageTag: e8a6a32b-6951-4411-a010-ddd026f6275d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Failed Payment Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_payment), dim_payment_status[payment_status_code] = "FAILED"), COUNTROWS(fact_payment), 0) * 100
		lineageTag: 6140f700-81f4-4c85-bb8a-e4268d253add

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Change Active vs Prior Year' = DIVIDE([Active Policies] - CALCULATE([Active Policies], SAMEPERIODLASTYEAR(dim_date[full_date])), CALCULATE([Active Policies], SAMEPERIODLASTYEAR(dim_date[full_date])), 0) * 100
		lineageTag: 0a8da42b-1c32-4709-9c26-dcd9884bf94a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Policy Status Distribution' = DIVIDE(CALCULATE(COUNTROWS(fact_policy)), CALCULATE(COUNTROWS(fact_policy), ALL(dim_policy_status)), 0)
		lineageTag: cffb7db5-d921-4eb1-8b0b-eec66b8efaee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Collected Amount' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PAID")
		lineageTag: 3fa7b7ef-fd04-4440-8c3b-a4a4becdaee7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Pending Amount' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING")
		lineageTag: c55bbd38-6fd2-43b7-b39c-dae32af7ec12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Failed Amount' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="FAILED")
		lineageTag: 5d308912-cf38-4fb5-ba5c-ff0523a58b25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Policies Issued' = CALCULATE(COUNTROWS(fact_policy))
		formatString: 0
		lineageTag: ec8f647e-dea4-4a24-bf24-756df372787a

	measure 'Monthly Cancellations' = CALCULATE(COUNTROWS(fact_cancellation))
		formatString: 0
		lineageTag: df7ad85f-1af2-4151-bda2-efa177943dc6

	measure 'Pending Aging: 0–7 Days' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING", fact_payment[aging_days] <= 7)
		lineageTag: bf455ebd-479d-4cb9-a44a-3e9fb9a7a655

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Aging: 8–30 Days' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING", fact_payment[aging_days] >= 8 && fact_payment[aging_days] <= 30)
		lineageTag: bfb37189-a89a-42f9-9174-7f541caa7e9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Aging: 31–60 Days' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING", fact_payment[aging_days] >= 31 && fact_payment[aging_days] <= 60)
		lineageTag: b3eee685-b447-4a58-853a-4723cfdde8b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Aging: 61–90 Days' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING", fact_payment[aging_days] >= 61 && fact_payment[aging_days] <= 90)
		lineageTag: 154ec5bc-cf87-4994-b02d-2dbb2e447a7f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Aging: >90 Days' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING", fact_payment[aging_days] > 90)
		lineageTag: 0b562d21-c992-42c3-a68e-9382f60ac4bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Payment Collection Rate by Provider' = CALCULATE([Payment Collection Rate])
		lineageTag: 3fc518fb-1040-40a8-80e5-377cb1245b2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Payment Time (Days)' =
			
			AVERAGEX(
			    FILTER(
			        fact_payment,
			        fact_payment[payment_amount] > 0
			            && RELATED(dim_payment_status[payment_status_code]) = "PAID"
			    ),
			    VAR IssuedDate =
			        CALCULATE(
			            MAX(dim_date[full_date]),
			            USERELATIONSHIP(
			                fact_payment[issued_date_key],
			                dim_date[date_key]
			            )
			        )
			    VAR PaymentDate =
			        CALCULATE(
			            MAX(dim_date[full_date]),
			            USERELATIONSHIP(
			                fact_payment[payment_date_key],
			                dim_date[date_key]
			            )
			        )
			    RETURN
			        DATEDIFF(
			            IssuedDate,
			            PaymentDate,
			            DAY
			        )
			)
		lineageTag: 6f548470-c147-48f7-8684-fd885aabc49e

	measure 'Policy Cancellation Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_cancellation)), CALCULATE(COUNTROWS(fact_policy)), 0)
		lineageTag: a5af4251-80ff-4102-a275-52b78967bb2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Policies Expiring Soon' = CALCULATE(COUNTROWS(fact_policy), dim_policy_status[policy_status_code]="ACTIVE", USERELATIONSHIP(fact_policy[policy_end_date_key], dim_date[date_key]), dim_date[full_date] <= TODAY() + 30)
		formatString: 0
		lineageTag: d86ab97f-a732-4be7-b047-beeb20215f61

	measure 'Refund Amount' = CALCULATE(SUM(fact_cancellation[refund_amount]))
		lineageTag: 345f7ba4-c3df-459c-a5a9-5b8d54901123

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Refund Rate' = DIVIDE([Refund Amount], [Refund Amount] + [Total Collected Premium], 0) * 100
		lineageTag: 429311f4-48e2-4d35-bb1e-d80786c4acf4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure aging_days =
			VAR PaymentDate =
			    CALCULATE(
			        MAX(dim_date[full_date]),
			        USERELATIONSHIP(fact_payment[payment_date_key], dim_date[date_key])
			    )
			RETURN
			    DATEDIFF(PaymentDate, TODAY(), DAY)
		lineageTag: 10afdf85-f577-40b0-9211-c0df71abbabc

	column Dummy
		lineageTag: 74378107-e74b-4ea1-8b5e-f418b945bc8f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dummy]

		annotation SummarizationSetBy = Automatic

	partition 'Measures DB2' = calculated
		mode: import
		source = DATATABLE("Dummy", STRING, {{"x"}})

	annotation PBI_Id = 9396c32880234acbb2dbf7a89ed4e388

