table 'Measures '
	lineageTag: 437f0056-7589-43a7-98fc-793adb84f474

	measure 'Total Quotations' = COUNTROWS(fact_quotation)
		formatString: 0
		lineageTag: d805fc63-5a23-4744-8904-e999d0e07b83

	measure 'Accepted Quotations' = CALCULATE([Total Quotations], dim_quotation_status[quotation_status_code] IN {"ACCEPTED", "CONVERTED"})
		lineageTag: cacb4ef0-2352-4b51-a00d-20fac0531be3

	measure 'Policies Issued' =
			
			COALESCE(
			    COUNTROWS(fact_policy),
			    0
			)
		formatString: 0
		lineageTag: cb124e25-7846-4645-961a-ecf360cea278

	measure 'Conversion Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_quotation), fact_quotation[converted_flag] = TRUE), COUNTROWS(fact_quotation), 0) * 100
		formatString: 0
		lineageTag: c113b65a-f655-4137-97b2-e3d933fa2631

	measure 'Total Written Premium (VND)' = SUM(fact_policy[premium_amount])
		formatString: 0
		lineageTag: 43751592-655d-4211-ad89-6da49afc00cc

	measure 'Collected Premium Revenue' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code] = "PAID")
		formatString: 0
		lineageTag: 8b036524-981b-4dd7-ae28-fc47260964bd

	measure 'Avg Written Premium per Policy (VND)' = DIVIDE([Total Written Premium (VND)], [Policies Issued], 0)
		lineageTag: 563a2d4c-b880-42c3-89fd-c0c61f8d8383

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT(fact_policy[customer_key]), dim_policy_status[policy_status_code] = "ACTIVE")
		formatString: 0
		lineageTag: a34df465-52ee-4224-9c4d-32faaa08b8be

	measure 'Policies In Force' = CALCULATE(COUNT(fact_policy[policy_key]), dim_policy_status[policy_status_code] = "ACTIVE")
		formatString: 0
		lineageTag: d1c8512e-0c0d-43f8-a93e-aab380dad6b7

	measure 'Funnel Drop-off: Issued → In Force' = [Policies Issued] - [Policies In Force]
		formatString: 0
		lineageTag: 289cfb97-cb55-4480-a6f6-bc399175abb0

	measure 'Quotation Count by Month' = CALCULATE([Total Quotations], DATESMTD(dim_date[full_date]))
		formatString: 0
		lineageTag: 251f8c59-b672-461e-9d63-cffca98c8fc2

	measure 'Policies Issued by Month' = CALCULATE([Policies Issued], DATESMTD(dim_date[full_date]))
		formatString: 0
		lineageTag: be6dd683-d862-4391-9720-0b28ca5256cb

	measure 'Conversion Rate by Month' = CALCULATE([Conversion Rate], DATESMTD(dim_date[full_date]))
		lineageTag: 7d784dda-175e-40f5-a5d4-08c2c39447ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Written Premium by Month' = CALCULATE([Total Written Premium (VND)], DATESMTD(dim_date[full_date]))
		formatString: 0
		lineageTag: b601b359-bf7f-4ac8-973e-f2480ccce1b6

	measure 'Growth Policies Issued %' = ```
			
			VAR SelectedYears =
			    DISTINCTCOUNT('dim_date'[year_number])
			VAR CurrentYear =
			    MAX('dim_date'[year_number])
			VAR CurrentValue =
			    [Policies Issued]
			VAR PreviousValue =
			    CALCULATE(
			        [Policies Issued],
			        FILTER(
			            ALL('dim_date'),
			            'dim_date'[year_number] = CurrentYear - 1
			        )
			    )
			VAR GrowthValue = 
			    DIVIDE(CurrentValue - PreviousValue, PreviousValue)
			RETURN
			    IF(
			        SelectedYears <> 1,
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            ISBLANK(GrowthValue), BLANK(),         
			            GrowthValue > 0, "▲ " & FORMAT(GrowthValue, "0.0%") & " vs PY",  
			            GrowthValue < 0, "▼ " & FORMAT(GrowthValue, "0.0%") & " vs PY", 
			            "▬ " & FORMAT(GrowthValue, "0.0%") & " vs PY"
			        )
			    )
			```
		lineageTag: a4c46162-f5a8-40dc-8aeb-8c9c076a7aa2

	measure 'Growth Policies Issued Icon' =
			
			IF(
			    [Growth Policies Issued %] >= 0,
			    UNICHAR(9650),
			    UNICHAR(9660)
			)
		lineageTag: 183eb34c-dbf4-4417-b5f4-c3b8ca20992d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Growth Policies Issued % Value' =
			
			VAR CurrentYear =
			    MAX('dim_date'[year_number])
			VAR CurrentValue =
			    [Policies Issued]
			VAR PreviousValue =
			    CALCULATE(
			        [Policies Issued],
			        FILTER(
			            ALL('dim_date'),
			            'dim_date'[year_number] = CurrentYear - 1
			        )
			    )
			RETURN
			    DIVIDE(CurrentValue - PreviousValue, PreviousValue)
		lineageTag: 69df36f4-88e9-4ff1-b4ff-27bd35a04b4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
		dataType: string
		lineageTag: a75398dc-0e6a-4b06-a27e-8044c1fcd000
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition 'Measures ' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

