table 'Measures DB2'
	lineageTag: b94ef46e-b5ff-4104-9d78-e866acf98a07

	measure 'Active Policies' = CALCULATE(COUNTROWS(fact_policy), dim_policy_status[policy_status_code]="ACTIVE")
		formatString: 0
		lineageTag: dbb19e59-0ca3-4555-bbac-8b02d08338a0

	measure 'Cancelled Policies' =
			
			COALESCE(
			    CALCULATE(COUNTROWS(fact_cancellation)),
			    0
			)
		formatString: 0
		lineageTag: 5c3fb1de-9700-4cbe-baad-e89c6c81e522

	measure 'Payment Collection Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_payment), dim_payment_status[payment_status_code] = "PAID"), COUNTROWS(fact_payment), 0)
		lineageTag: 955b88a5-af90-4dca-ab81-319ca3511f0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Written Premium' =
			
			COALESCE(
			    CALCULATE(
			        SUM(fact_policy[premium_amount]),
			        dim_policy_status[policy_status_code] IN {"ACTIVE", "EXPIRED"}
			    ),
			    0
			)
		lineageTag: e01b5eeb-9a53-4b97-83e5-8200907ca861

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Collected Premium' =
			
			CALCULATE(
			    SUM(fact_payment[payment_amount]),
			    dim_payment_status[payment_status_code] = "PAID"
			)
			+ 0
		lineageTag: b3f97019-72b4-42dc-87c8-d1f6d3cfe6d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pending Payments (VND)' = CALCULATE(SUM(fact_payment[payment_amount]), dim_payment_status[payment_status_code]="PENDING")
		lineageTag: e8a6a32b-6951-4411-a010-ddd026f6275d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Failed Payment Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_payment), dim_payment_status[payment_status_code] = "FAILED"), COUNTROWS(fact_payment), 0)
		lineageTag: 6140f700-81f4-4c85-bb8a-e4268d253add

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Change Active vs Prior Year' = DIVIDE([Active Policies] - CALCULATE([Active Policies], SAMEPERIODLASTYEAR(dim_date[full_date])), CALCULATE([Active Policies], SAMEPERIODLASTYEAR(dim_date[full_date])), 0) * 100
		lineageTag: 0a8da42b-1c32-4709-9c26-dcd9884bf94a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Policy Status Distribution' = DIVIDE(CALCULATE(COUNTROWS(fact_policy)), CALCULATE(COUNTROWS(fact_policy), ALL(dim_policy_status)), 0)
		lineageTag: cffb7db5-d921-4eb1-8b0b-eec66b8efaee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

