	measure 'Payment Collection Rate by Provider' = CALCULATE([Payment Collection Rate])
		lineageTag: 3fc518fb-1040-40a8-80e5-377cb1245b2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Payment Time (Days)' =
			
			AVERAGEX(
			    FILTER(
			        fact_payment,
			        fact_payment[payment_amount] > 0
			            && RELATED(dim_payment_status[payment_status_code]) = "PAID"
			    ),
			    VAR IssuedDate =
			        CALCULATE(
			            MAX(dim_date[full_date]),
			            USERELATIONSHIP(
			                fact_payment[issued_date_key],
			                dim_date[date_key]
			            )
			        )
			    VAR PaymentDate =
			        CALCULATE(
			            MAX(dim_date[full_date]),
			            USERELATIONSHIP(
			                fact_payment[payment_date_key],
			                dim_date[date_key]
			            )
			        )
			    RETURN
			        DATEDIFF(
			            IssuedDate,
			            PaymentDate,
			            DAY
			        )
			)
		lineageTag: 6f548470-c147-48f7-8684-fd885aabc49e

	measure 'Policy Cancellation Rate' =
			
			DIVIDE(
			    COALESCE(CALCULATE(COUNTROWS(fact_cancellation)), 0),
			    COALESCE(CALCULATE(COUNTROWS(fact_policy)), 0),
			    0
			)
		lineageTag: a5af4251-80ff-4102-a275-52b78967bb2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Policies Expiring Soon' = CALCULATE(COUNTROWS(fact_policy), dim_policy_status[policy_status_code]="ACTIVE", USERELATIONSHIP(fact_policy[policy_end_date_key], dim_date[date_key]), dim_date[full_date] <= TODAY() + 30)
		formatString: 0
		lineageTag: d86ab97f-a732-4be7-b047-beeb20215f61

	measure 'Refund Amount' = CALCULATE(SUM(fact_cancellation[refund_amount]))
		lineageTag: 345f7ba4-c3df-459c-a5a9-5b8d54901123

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Refund Rate' = DIVIDE([Refund Amount], [Refund Amount] + [Total Collected Premium], 0) * 100
		lineageTag: 429311f4-48e2-4d35-bb1e-d80786c4acf4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure aging_days =
			VAR PaymentDate =
			    CALCULATE(
			        MAX(dim_date[full_date]),
			        USERELATIONSHIP(fact_payment[payment_date_key], dim_date[date_key])
			    )
			RETURN
			    DATEDIFF(PaymentDate, TODAY(), DAY)
		lineageTag: 10afdf85-f577-40b0-9211-c0df71abbabc

