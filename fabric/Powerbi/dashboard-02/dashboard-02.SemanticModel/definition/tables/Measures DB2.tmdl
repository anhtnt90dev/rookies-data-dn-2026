	measure 'Growth Total Written Premium %' = ```
			
			VAR SelectedYears =
			    DISTINCTCOUNT('dim_date'[year_number])
			VAR CurrentYear =
			    MAX('dim_date'[year_number])
			VAR CurrentValue =
			    [Total Written Premium (VND)]
			VAR PreviousValue =
			    CALCULATE(
			        [Total Written Premium (VND)],
			        FILTER(
			            ALL('dim_date'),
			            'dim_date'[year_number] = CurrentYear - 1
			        )
			    )
			VAR GrowthValue = 
			    DIVIDE(CurrentValue - PreviousValue, PreviousValue)
			RETURN
			    IF(
			        SelectedYears <> 1,
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            ISBLANK(GrowthValue), BLANK(),          
			            GrowthValue > 0, "▲ " & FORMAT(GrowthValue, "0.0%") & " vs PY",  
			            GrowthValue < 0, "▼ " & FORMAT(GrowthValue, "0.0%") & " vs PY", 
			            "▬ " & FORMAT(GrowthValue, "0.0%") & " vs PY"                
			        )
			    )
			```
		lineageTag: 7e6f98a3-e713-452c-8597-0b2ec05f6dd1

