	measure 'Top Premium Provider' =
			
			CALCULATE(
			    SELECTEDVALUE(dim_provider[provider_name]),
			    TOPN(
			        1,
			        FILTER(
			            ALL(dim_provider[provider_name]),
			            dim_provider[provider_name] <> "UNKNOWN"
			                && NOT ISBLANK(dim_provider[provider_name])
			        ),
			        CALCULATE(SUM(fact_policy[premium_amount])),
			        DESC
			    )
			)
		lineageTag: cd2b32c8-d966-4951-b72d-b680908cc8be

	measure 'Best Collection Rate Provider' =
			
			VAR TopRate =
			    MAXX(
			        ALL(dim_provider),
			        [Payment Collection Rate by Provider]
			    )
			
			RETURN
			    CONCATENATEX(
			        FILTER(
			            ALL(dim_provider),
			            [Payment Collection Rate by Provider] = TopRate
			        ),
			        dim_provider[provider_name],
			        ", "
			    )
		lineageTag: 4865493f-e8e3-4ed9-be8c-41e43e81850f

	measure 'Highest Cancel Rate Provider' =
			
			CALCULATE(
			    SELECTEDVALUE(dim_provider[provider_name]),
			    TOPN(
			        1,
			        FILTER(
			            ALL(dim_provider[provider_name]),
			            dim_provider[provider_name] <> "UNKNOWN"
			        ),
			        [Total Collected Premium],
			        DESC
			    )
			)
		lineageTag: 8ce93e8c-1cca-4c39-b3e6-1fb70dfc3baa

