table 'Comparison type'
	lineageTag: 7098bcb3-fbdc-4b6e-88fb-baa58ee79f41

	calculationGroup

		calculationItem Growth% =
				VAR CurrentValue = SELECTEDMEASURE()
				
				VAR PreviousValue =
				    SWITCH(
				        TRUE(),
				        SELECTEDVALUE('Time Calculation'[Name]) = "MTD",
				            CALCULATE(
				                SELECTEDMEASURE(),
				                DATEADD('dim_date'[full_date], -1, MONTH)
				            ),
				        SELECTEDVALUE('Time Calculation'[Name]) = "YTD",
				            CALCULATE(
				                SELECTEDMEASURE(),
				                DATEADD('dim_date'[full_date], -1, YEAR)
				            )
				    )
				
				RETURN
				    DIVIDE(CurrentValue - PreviousValue, PreviousValue)

	column Name
		dataType: string
		lineageTag: 53e35a59-02cc-4dc7-9b65-aeae1d1f2595
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		lineageTag: d3f48aee-6b38-405e-a687-343d36ef5e2c
		sourceColumn: Ordinal

